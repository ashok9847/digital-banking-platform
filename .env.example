# ==============================================================================
# Enterprise Digital Banking Platform - Environment Configuration Template
# Copy this file to .env and configure local secret values before running.
# DO NOT commit .env to version control!
# ==============================================================================

# Database Configuration
DB_USERNAME=root
DB_PASSWORD=your_secure_database_password_here
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_database_password_here
MYSQL_ROOT_PASSWORD=your_secure_database_password_here

# Database Host & Port
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Kafka Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security (Must be a 256-bit Base64-encoded secret key for HMAC-SHA256)
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Inter-Service Authentication Key
INTERNAL_SERVICE_KEY=your_secure_internal_service_key_here
