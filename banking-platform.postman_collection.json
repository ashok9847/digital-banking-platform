{
  "info": {
    "name": "Digital Banking Platform APIs",
    "description": "Enterprise BFSI Core Banking Platform API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountA",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountB",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Register Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john.doe@bank.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"ROLE_CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/auth/register",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Login (Generates JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    console.log('JWT Token saved to collection variable!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/me",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Customer Management",
      "item": [
        {
          "name": "2.1 Create KYC Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@bank.com\",\n  \"phone\": \"+1234567890\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"address\": \"100 Wall Street, New York, NY\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/customers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "customers"]
            }
          }
        },
        {
          "name": "2.2 Get Customer By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:8082/api/customers/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "customers", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Account Service",
      "item": [
        {
          "name": "3.1 Open Savings Account A ($1000)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"USD\",\n  \"initialDeposit\": 1000.00\n}"
            },
            "url": {
              "raw": "http://localhost:8083/api/accounts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["api", "accounts"]
            }
          }
        },
        {
          "name": "3.2 Open Current Account B ($100)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"accountType\": \"CURRENT\",\n  \"currency\": \"USD\",\n  \"initialDeposit\": 100.00\n}"
            },
            "url": {
              "raw": "http://localhost:8083/api/accounts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["api", "accounts"]
            }
          }
        },
        {
          "name": "3.3 Get Account Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:8083/api/accounts/ACC10000001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["api", "accounts", "ACC10000001"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Transactions & Ledger",
      "item": [
        {
          "name": "4.1 Deposit Funds ($500)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idemp-deposit-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"ACC10000001\",\n  \"amount\": 500.00,\n  \"currency\": \"USD\",\n  \"description\": \"Branch Cash Deposit\"\n}"
            },
            "url": {
              "raw": "http://localhost:8084/api/transactions/deposit",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8084",
              "path": ["api", "transactions", "deposit"]
            }
          }
        },
        {
          "name": "4.2 Transfer Money ($250)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idemp-transfer-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccount\": \"ACC10000001\",\n  \"destinationAccount\": \"ACC10000002\",\n  \"amount\": 250.00,\n  \"currency\": \"USD\",\n  \"description\": \"Consultancy invoice payment\"\n}"
            },
            "url": {
              "raw": "http://localhost:8084/api/transactions/transfer",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8084",
              "path": ["api", "transactions", "transfer"]
            }
          }
        },
        {
          "name": "4.3 Account Statement / History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:8084/api/transactions/account/ACC10000001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8084",
              "path": ["api", "transactions", "account", "ACC10000001"]
            }
          }
        }
      ]
    }
  ]
}
